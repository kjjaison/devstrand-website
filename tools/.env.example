# Copy to .env and paste your tunnel token from Cloudflare Zero Trust.
# Never commit the real .env file.

CLOUDFLARE_TUNNEL_TOKEN=

# Optional: email delivery of tool results (SMTP).
# Leave blank to keep "Email file" disabled in the UI.
# Examples: Google Workspace, Microsoft 365, Resend SMTP, Mailgun SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Attachment size cap for email (many providers reject >20–25 MB)
EMAIL_MAX_MB=20
# Max emails per client IP per hour
EMAIL_RATE_LIMIT=8

# Temporary shareable download links
SHARE_MAX_MB=50
SHARE_RATE_LIMIT=20

# Usage analytics (IP, country via Cloudflare CF-IPCountry, tool, filenames/sizes, shares)
USAGE_LOG_ENABLED=true
# Required to call GET /api/admin/usage — generate with: openssl rand -hex 24
USAGE_ADMIN_TOKEN=
# Optional override (default: $TOOLS_TMP/usage)
# USAGE_LOG_DIR=